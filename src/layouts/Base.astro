---
import { SITE_NAME } from '../site.config';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE_NAME}</title>
    <style>
      :root { --fg:#1a1a1a; --bg:#fff; --muted:#555; --accent:#1d4ed8; --warn:#fff4d6; --warnb:#e0b341; }
      body { font:16px/1.6 system-ui,sans-serif; color:var(--fg); background:var(--bg); margin:0; }
      main,header,footer { max-width:46rem; margin:0 auto; padding:1rem; }
      a { color:var(--accent); } nav a { margin-right:1rem; }
      .disclaimer { background:var(--warn); border:1px solid var(--warnb); border-radius:6px; padding:.75rem 1rem; font-size:.9rem; }
      .meta { color:var(--muted); font-size:.9rem; }
      .badge { display:inline-block; padding:0 .5rem; border-radius:99px; background:#eee; font-size:.8rem; }
      .badge.a_verifier,.badge.brouillon { background:var(--warn); }
      pre { background:#f5f5f5; padding:1rem; overflow:auto; white-space:pre-wrap; }
    </style>
  </head>
  <body>
    <header><nav><strong>{SITE_NAME}</strong> · <a href="/">Accueil</a><a href="/contribuer/">Contribuer</a></nav></header>
    <main>
      <div class="disclaimer" role="note">
        <strong>Information, pas conseil juridique.</strong> Ce site, collaboratif et non officiel, n'est affilié à aucun
        organisme (Ameli, CPAM, Cramif, CAF). Les fiches peuvent être incomplètes ou périmées : vérifiez toujours
        sur les sources officielles liées et, si besoin, auprès d'un professionnel du droit ou d'une association.
      </div>
      <slot />
    </main>
    <footer class="meta">Code sous AGPL-3.0, contenu sous CC BY-SA 4.0. Contenu collaboratif — corrections et retours via Git (voir « Contribuer »).</footer>
  </body>
</html>
