---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site.config';
import { relecture } from '../lib/labels';
const byTitle = (a: any, b: any) => a.data.title.localeCompare(b.data.title, 'fr');
const fiches = (await getCollection('fiches')).sort(byTitle);
const courriers = (await getCollection('courriers')).sort(byTitle);
---
<Base title={SITE_NAME}>
  <div class="wrap">
    <section class="hero">
      <h1>Un désaccord avec la Sécu ou la CAF ?</h1>
      <p>Les démarches à suivre, les textes de loi qui s'appliquent et les courriers à envoyer, avec la date de dernière vérification de chaque source.</p>
    </section>

    <h2 class="section">Situations</h2>
    <ul class="rows">
      {fiches.map((f) => (
        <li>
          <a class="row" href={`/fiches/${f.id}/`}>
            <h3>{f.data.title}</h3>
            <p>{f.data.summary}</p>
            <div class="side">
              <span class="org">{f.data.organismes.join(' · ')}</span>
              <span class={`stamp ${f.data.statut_relecture}`}>{relecture[f.data.statut_relecture].label}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="section">Courriers types</h2>
    <ul class="rows">
      {courriers.map((c) => (
        <li>
          <a class="row" href={`/courriers/${c.id}/`}>
            <h3>{c.data.title.replace(/^Modèle : /, '')}</h3>
            <p>{c.data.summary}</p>
            <div class="side"><span class="org">{c.data.organismes.join(' · ')}</span></div>
          </a>
        </li>
      ))}
    </ul>

    <p class="more">Une erreur, un retour d'expérience ? <a href="/contribuer/">Voir comment contribuer</a>.</p>
  </div>
</Base>
