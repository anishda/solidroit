---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const fiches = (await getCollection('fiches')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));
const courriers = (await getCollection('courriers')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));
---
<Base title="Accueil">
  <h1>Que faire en cas de problème avec la Sécu ou la CAF ?</h1>
  <p>Parcours par situation, textes de loi cités, liens officiels et courriers types.</p>
  <h2>Situations</h2>
  <ul>
    {fiches.map((f) => (
      <li>
        <a href={`/fiches/${f.id}/`}>{f.data.title}</a>
        <span class={`badge ${f.data.statut_relecture}`}>{f.data.statut_relecture}</span>
        <div class="meta">{f.data.summary}</div>
      </li>
    ))}
  </ul>
  <h2>Courriers types</h2>
  <ul>
    {courriers.map((c) => (<li><a href={`/courriers/${c.id}/`}>{c.data.title}</a></li>))}
  </ul>
</Base>
