---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { relecture, sourceStatut, fmtDate, splitSource } from '../../lib/labels';

export async function getStaticPaths() {
  const entries = await getCollection('fiches');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <div class="wrap page">
    <div class="crumbs"><a href="/">Situations</a> / {d.organismes.join(' · ')}</div>
    <h1>{d.title}</h1>
    <div class="meta">
      <span class={`stamp ${d.statut_relecture}`}>{relecture[d.statut_relecture].label}</span>
      <span>Sources vérifiées le {fmtDate(d.derniere_verification)}</span>
      <span>Relecteur : {d.relecteur}</span>
    </div>
    <div class="layout">
      <div>
        {d.revue_ia && (
          <div class="review">
            <strong>Relecture IA du {fmtDate(d.revue_ia.date)}</strong>
            {d.revue_ia.resume}
          </div>
        )}
        {'delais' in d && d.delais.length > 0 && (
          <section class="delais" aria-label="Délais à retenir">
            <h2>Délais à retenir</h2>
            <dl>
              {d.delais.map((x) => (
                <>
                  <dt>{x.quoi}</dt>
                  <dd><span class="delai">{x.delai}</span> <span class="ref">{x.ref}</span></dd>
                </>
              ))}
            </dl>
          </section>
        )}
        <div class="md steps"><Content /></div>
      </div>
      <aside class="margin" aria-label="Sources">
        <section>
          <h2>Sources légales</h2>
          <ul>
            {d.sources_legales.map((s) => {
              const x = splitSource(s.ref);
              return (
                <li>
                  <div class="src-head">
                    <span class="ref">{s.url ? <a href={s.url}>{x.ref}</a> : x.ref}</span>
                    <span class={`stamp ${s.statut}`}>{sourceStatut[s.statut].label}</span>
                  </div>
                  {x.desc && <p class="src-desc">{x.desc}</p>}
                  {s.note && <p class="src-note">{s.note}</p>}
                </li>
              );
            })}
          </ul>
        </section>
        <section>
          <h2>Liens officiels</h2>
          <ul>{d.liens_officiels.map((l) => (<li><a href={l.url}>{l.label}</a></li>))}</ul>
        </section>
        {'courriers' in d && d.courriers.length > 0 && (
          <section>
            <h2>Courriers types</h2>
            <ul>{d.courriers.map((c) => (<li><a href={`/courriers/${c}/`}>{c.replace(/-/g, ' ')}</a></li>))}</ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</Base>
